# ============================================================
#  Tidal AI 大脑 — 环境变量模板
#  复制为 .env 并填写。NEVER commit 已填写的 .env 文件。
#     cp .env.example .env
# ============================================================

# ---- 聊天中继连接 ------------------------------------------------
RELAY_URL=http://127.0.0.1:3011
# 可留空：start.bat / start.sh 会注入与中继相同的 RELAY_SECRET
RELAY_SECRET=

# ---- 出站代理（可选）----------------------------------------------
# 优先读 HTTPS_PROXY / HTTP_PROXY。api.deepseek.com 直连。
# 本机 Gemini 需要走本地代理时，显式填 TIDAL_LOCAL_PROXY（不要写死在代码里）。
# 海外云服务器不要设任何指向本机的代理。
# HTTPS_PROXY=http://127.0.0.1:7890
# TIDAL_LOCAL_PROXY=http://127.0.0.1:7890
# TIDAL_ENV=production

# ---- 聊天大脑模型（首选）— 本地开发推荐 DeepSeek ---------------
# 每个分组 _1 是首选，_2 / _3 是备用（按顺序故障降级）
CHAT_API_BASE_1=https://api.deepseek.com/v1
CHAT_API_KEY_1=sk-your-deepseek-key
CHAT_MODEL_1=deepseek-flash

# ---- 聊天大脑模型（备用 1）— 可选，注释即禁用 -------------------
# CHAT_API_BASE_2=https://api.openai.com/v1
# CHAT_API_KEY_2=sk-your-openai-key
# CHAT_MODEL_2=gpt-4o-mini

# ---- 聊天大脑模型（备用 2）-------------------------------------
# CHAT_API_BASE_3=
# CHAT_API_KEY_3=
# CHAT_MODEL_3=

# ---- 记忆服务地址（Phase 3 启用）------------------------------
MEMORY_URL=http://127.0.0.1:3013

# ---- 记忆流水线模型（独立配置，Phase 3 记忆服务上线后启用）------
# MEMORY_API_BASE_1=https://api.deepseek.com/v1
# MEMORY_API_KEY_1=sk-your-deepseek-key
# MEMORY_MODEL_1=deepseek-flash

# ---- 通用参数 ---------------------------------------------------
LLM_TEMPERATURE=0.7           # 生成温度（0-2）
LLM_MAX_TOKENS=4096           # 最大输出 token 数
LLM_STREAM=1                  # 1=流式输出, 0=非流式
# HISTORY_N 代码默认 12；设置页 history_n 每轮覆盖。仅在无设置库时用环境变量覆盖启动值
# HISTORY_N=12

# ---- 称呼（默认 User / Assistant；与 memory_config 对齐）---------
# HUMAN_NAME=User
# AI_NAME=Assistant

# ---- 人设 -------------------------------------------------------
# 直接写或从文件读，二选一。都不填则用内置默认人设。
# PERSONA=你是對方的 AI 伴侶，在一個私密的一對一聊天裡。說話自然、簡短、有溫度，像用手機聊天，不要長篇大論。
# PERSONA_FILE=./persona.txt

# ---- 状态持久化 -------------------------------------------------
# BRIDGE_STATE_DIR=./.bridge_state

# ---- 临时：把发给 Gemini 的请求体写到 .bridge_state/llm_dumps/（不含 Key）----
# 验隐式缓存用，验完改回 0。不要开太久。
# DEBUG_LLM_DUMP=0

# ---- Gemini 聊天模式 / 显式 Cache -------------------------------------------
# generate（默认）= generateContent + cachedContents；interactions = 旧有状态链（回滚）
# GEMINI_CHAT_MODE=generate
# GEMINI_CACHE_TTL_SEC=1800
# GEMINI_CACHE_PATCH_REMAINING_SEC=600

# ---- Google Search grounding（付费 Gemini 3.x）--------------------------------
# 1=额度内挂 google_search（与自定义 function 并存）；0=总关。
# GEMINI_GOOGLE_SEARCH=1
# 本地月硬顶（官方约 5000；默认 3000，宁早停）
# GROUNDING_MONTHLY_LIMIT=3000

# ---- Snapshot / 显式缓存（P1+）----------------------------------------------
# 约每 N 轮固化；首周期 B 区最多轮数
# SNAPSHOT_CONSOLIDATE_ROUNDS=10
# SNAPSHOT_FRESH_MAX_ROUNDS=10
# 默认关闭常驻 [相关记忆]；需要旧行为时设 1
# INJECT_RELATED_MEMORY=0

# ---- Gemini Interactions 验收 ------------------------------------------------
# 默认 1：Gemini 失败不静默切 DeepSeek；仅显式 GEMINI_NO_FALLBACK=0 时允许 fallback。
# GEMINI_NO_FALLBACK=0

# ---- Gemini ix 大周期截断（仅 GEMINI_CHAT_MODE=interactions 回滚路径）--------
# generate 模式下 bridge 不再调用；默认关闭以免误触
# GEMINI_IX_RESET_ENABLED=0
# GEMINI_IX_RESET_INPUT=15000
# GEMINI_IX_RESET_MISS_INPUT=12000
# GEMINI_IX_RESET_MISS_STREAK=3
# GEMINI_IX_BOOTSTRAP_ROUNDS=3

# ---- Gemini token 日志（宿主机 logs/brain_gemini_ix.log，Docker 挂载 /app/logs）----
# 设 0/false/off 可关闭文件追加（仍打 stderr）。本机未挂卷时默认仓库 logs/brain_gemini_ix.log
# GEMINI_IX_LOG_PATH=/app/logs/brain_gemini_ix.log