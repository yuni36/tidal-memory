# ============================================================
#  Tidal 记忆服务 — 环境变量模板
#  复制为 .env 并填写。NEVER commit 已填写的 .env 文件。
#     cp .env.example .env
# ============================================================

# ---- 服务端口 ----
MEMORY_PORT=3013

# ---- 中继（start.bat / Docker Compose 会注入 RELAY_SECRET；也可写在这里）----
RELAY_URL=http://127.0.0.1:3011
RELAY_SECRET=

# 海外云不要设代理、不要写死 127.0.0.1:7890；本地 Gemini 可用 HTTPS_PROXY
# HTTPS_PROXY=http://127.0.0.1:7890
# TIDAL_ENV=production
# Docker 内：CHROMA_URL=http://chroma:7707（本机默认 127.0.0.1:7707，可省略）
# CHROMA_URL=http://127.0.0.1:7707

# ---- LLM API Key（记忆管线提取/整理用）----
# DeepSeek / OpenAI 兼容 API Key
DEEPSEEK_API_KEY=sk-your-api-key-here
API_KEY=sk-your-api-key-here

# ---- 整理：航海 / 今日事件线（两行独立 api_configs；启动时从积温 affect_* 同步 base+key）----
# SUMMARY_MODEL=gemini-3.5-flash-lite
# SUMMARY_VOYAGE_MODEL=gemini-3.5-flash-lite
# SUMMARY_DAILY_MODEL=gemini-3.5-flash-lite
# 也可手动指定已有行名：
# SUMMARY_VOYAGE_API=summary-voyage
# SUMMARY_DAILY_API=summary-daily

# ---- 加密密钥（64位 hex，用于记忆加密存储）----
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANCTUARY_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# ---- Session（不再需要网页登录，保留兼容）----
SESSION_SECRET=tidal-memory-dev-secret
LOGIN_PASSWORD=

# ---- 天气（wttr.in；城市在网页设置页选择，默认北京；这里仅作老版本兜底）----
# WEATHER_QUERY=Beijing
# WEATHER_LABEL=Beijing
# WEATHER_REFRESH_HOURS=1
