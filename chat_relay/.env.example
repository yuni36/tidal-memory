# ============================================================
#  Tidal 聊天中继 — 环境变量模板
#  复制为 .env 并填写。NEVER commit 已填写的 .env 文件。
#     cp .env.example .env
# ============================================================

# ---- 必填：鉴权密钥 ------------------------------------------------
# 一把密钥守护所有端点。PWA 前端和 AI 大脑都用它作 Bearer Token。
# 开发环境：设为 0（与 start.bat 默认一致，直接可用）
# 若设置页改过连接密钥，启动脚本优先读 sidecar chat_relay/.relay_secret
# 生产环境：必须替换为随机高熵值，禁止把 0 打进镜像 / 上云：
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Docker：compose 用根目录 .env 的 RELAY_SECRET，并设 TIDAL_BIND=0.0.0.0（本机默认仍 127.0.0.1）
# TIDAL_BIND=127.0.0.1
RELAY_SECRET=0

# ---- 身份名称 ------------------------------------------------------
RELAY_AI_NAME=Assistant       # AI 伙伴的显示名（公开默认勿用私人昵称）
RELAY_HUMAN_NAME=User         # 你的称呼

# ---- 路径 / 网络 ---------------------------------------------------
RELAY_PORT=3011               # 服务端口
RELAY_DB=./data/tidal.db      # SQLite（相对 app.py）；不设则默认 data/，旧 tidal.db 仍在则回退
RELAY_UPLOAD_DIR=./uploads    # 上传文件目录（相对于 app.py）
RELAY_PUBLIC_PREFIX=          # 公开 URL 前缀（生产环境 nginx 反代时设置，本地留空）
RELAY_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---- 上传限制 -------------------------------------------------------
RELAY_MAX_UPLOAD_BYTES=10485760   # 10 MB

# ---- Web Push / VAPID（可选；锁屏通知）-------------------------------
# 生产在服务器上生成（pem 不进 git；本机另有一套）:
#   python chat_relay/setup_vapid_env.py --sub mailto:admin@your.site
# Docker 只读 chat_relay/.env；私钥字符串即可，容器内可以没有 pem 文件。
# 未配置时聊天照常，仅推送功能不可用。需 HTTPS（localhost 例外）。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_PRIVATE_PEM=private_key.pem
# VAPID_CLAIMS_SUB=mailto:admin@your.site
# VAPID_SUBJECT=mailto:admin@your.site

# ---- 自建 ntfy（可选；国内推送主通道，与 Web Push 并行）-----------------
# 完整 topic URL（topic 当作密码，用长随机串）。未配置则跳过，不影响聊天。
# 例：https://ntfy.example.com/your-secret-topic
# NTFY_URL=
# NTFY_TIMEOUT_SEC=8
